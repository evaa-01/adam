diff --git a/ultramodern/include/ultramodern/os_objects.hpp b/ultramodern/include/ultramodern/os_objects.hpp
new file mode 100644
index 0000000..20d5c2f
--- /dev/null
+++ b/ultramodern/include/ultramodern/os_objects.hpp
@@ -0,0 +1,13 @@
+#pragma once
+
+#include <cstdint>
+
+// adam patch (rewind): reports the OS objects the game creates in RDRAM, so a RAM rewind can leave them alone (their
+// state belongs to the host threads and queues, which aren't rewound).
+namespace ultramodern {
+    enum class OsObjectKind { Thread, MesgQueue, MesgBuffer };
+    // addr/size: the object in RDRAM (KSEG0 address). For a thread, stack_top is the sp the game passed, else 0.
+    using os_object_callback_t = void (*)(OsObjectKind kind, uint32_t addr, uint32_t size, uint32_t stack_top);
+    void set_os_object_callback(os_object_callback_t callback);
+    void report_os_object(OsObjectKind kind, uint32_t addr, uint32_t size, uint32_t stack_top);
+}
