+static ultramodern::os_object_callback_t os_object_callback = nullptr;
+void ultramodern::set_os_object_callback(os_object_callback_t callback) { os_object_callback = callback; }
+void ultramodern::report_os_object(OsObjectKind kind, uint32_t addr, uint32_t size, uint32_t stack_top) {
+    if (os_object_callback != nullptr) {
