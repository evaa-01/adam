+        // Draws a sprite from the texture already in TMEM as an axis-aligned rectangle: object coordinates (s10.2) map
+        // to the screen as originX + mulX * x, originY + mulY * y. A negative factor mirrors the image. Both edges are
+        // mapped and rounded the same way (not position + size), so sprites that touch in object space (games build
+        // big images from strips) still touch on screen at any scale, without gap lines.
+        static void drawObjSprite(State *state, const uObjSprite *sprite, int32_t originX, int32_t originY, float mulX, float mulY) {
+            RDP *rdp = state->rdp.get();
+            const uint8_t clamp = (state->rsp->objRenderMode & S2DEX_G_OBJRM_NOTXCLAMP) ? G_TX_WRAP : G_TX_CLAMP;
+            rdp->setTile(G_TX_RENDERTILE, sprite->imageFmt, sprite->imageSiz, sprite->imageStride, sprite->imageAdrs, sprite->imagePal, clamp, clamp, 0, 0, 0, 0);
+
+            // Image size is u10.5, tile size u10.2.
+            const uint16_t imageW = std::max(sprite->imageW, uint16_t(32));
+            const uint16_t imageH = std::max(sprite->imageH, uint16_t(32));
+            rdp->setTileSize(G_TX_RENDERTILE, 0, 0, (imageW >> 3) - 4, (imageH >> 3) - 4);
+
+            // Object-space size (s10.2) = image size (u10.5) / scale (u5.10).
+            const uint16_t scaleW = std::max(sprite->scaleW, uint16_t(1));
+            const uint16_t scaleH = std::max(sprite->scaleH, uint16_t(1));
+            const int32_t objW = ((int32_t(imageW) << 10) / scaleW) >> 3;
+            const int32_t objH = ((int32_t(imageH) << 10) / scaleH) >> 3;
+            auto mapX = [&](int32_t x) { return originX + int32_t(std::floor(double(mulX) * double(x))); };
+            auto mapY = [&](int32_t y) { return originY + int32_t(std::floor(double(mulY) * double(y))); };
+            int32_t ulx = mapX(sprite->objX);
+            int32_t lrx = mapX(sprite->objX + objW);
+            int32_t uly = mapY(sprite->objY);
+            int32_t lry = mapY(sprite->objY + objH);
+            bool flipS = (sprite->imageFlags & S2DEX_G_OBJ_FLAG_FLIPS) != 0;
+            bool flipT = (sprite->imageFlags & S2DEX_G_OBJ_FLAG_FLIPT) != 0;
+            if (lrx < ulx) {
+                std::swap(ulx, lrx);
+                flipS = !flipS;
+            }
+
+            if (lry < uly) {
+                std::swap(uly, lry);
+                flipT = !flipT;
+            }
+
+            if ((ulx == lrx) || (uly == lry)) {
+                return;
+            }
+
+            int16_t uls = 0;
+            int16_t ult = 0;
+            int16_t dsdx = int16_t(float(scaleW) / std::fabs(mulX));
+            int16_t dtdy = int16_t(float(scaleH) / std::fabs(mulY));
+            if (rdp->otherMode.cycleType() == G_CYC_COPY) {
+                // Copy mode: 4 texels per step, inclusive lower right corner.
+                dsdx = 4 << 10;
+                dtdy = 1 << 10;
+                lrx -= 4;
+                lry -= 4;
+            }
+            else {
+                if (flipS) {
+                    uls = int16_t(imageW - 32);
+                    dsdx = -dsdx;
+                }
+
+                if (flipT) {
+                    ult = int16_t(imageH - 32);
+                    dtdy = -dtdy;
+                }
+
+                // Sub-pixel positioning, as the microcode does for bilerp scrolling: the rectangle starts on whole
+                // pixels (both edges rounded up the same way, so strips still meet), and the fraction it moved goes
+                // into the texture start. Passing a fractional rectangle instead snaps the image to whole pixels:
+                // a slow pan then only moves every 4 quarter-pixel steps. Units: (quarter pixels) * s5.10 / 128 = s10.5.
+                const int32_t snapX = (ulx + 3) & ~3;
+                const int32_t snapY = (uly + 3) & ~3;
+                uls = int16_t(uls + ((snapX - ulx) * dsdx) / 128);
+                ult = int16_t(ult + ((snapY - uly) * dtdy) / 128);
+                ulx = snapX;
+                uly = snapY;
+                lrx = (lrx + 3) & ~3;
+                lry = (lry + 3) & ~3;
+                if ((ulx >= lrx) || (uly >= lry)) {
+                    return;
+                }
+            }
+
+            rdp->drawTexRect(ulx, uly, lrx, lry, G_TX_RENDERTILE, uls, ult, dsdx, dtdy, false);
+        }
+
+        // G_OBJ_RECTANGLE and the draw half of G_OBJ_LDTX_RECT: screen coordinates, no matrix.
+        void doObjRectangle(State *state, const uObjSprite *sprite) {
+            drawObjSprite(state, sprite, 0, 0, 1.0f, 1.0f);
+        }
+
+        // Draws a sprite through a general 2D matrix (rotation, skew) as two textured triangles, like the microcode:
+        // screen = (A * x + B * y + X, C * x + D * y + Y) for object coordinates x, y.
+        static void drawObjSpriteAffine(State *state, const uObjSprite *sprite, float A, float B, float C, float D, float X, float Y) {
+            RDP *rdp = state->rdp.get();
+            const uint8_t clamp = (state->rsp->objRenderMode & S2DEX_G_OBJRM_NOTXCLAMP) ? G_TX_WRAP : G_TX_CLAMP;
+            rdp->setTile(G_TX_RENDERTILE, sprite->imageFmt, sprite->imageSiz, sprite->imageStride, sprite->imageAdrs, sprite->imagePal, clamp, clamp, 0, 0, 0, 0);
+            const uint16_t imageW = std::max(sprite->imageW, uint16_t(32));
+            const uint16_t imageH = std::max(sprite->imageH, uint16_t(32));
+            rdp->setTileSize(G_TX_RENDERTILE, 0, 0, (imageW >> 3) - 4, (imageH >> 3) - 4);
+
+            // Object-space rectangle in pixels: image size (u10.5) / scale (u5.10).
+            const uint16_t scaleW = std::max(sprite->scaleW, uint16_t(1));
+            const uint16_t scaleH = std::max(sprite->scaleH, uint16_t(1));
+            const float x0 = sprite->objX / 4.0f;
+            const float y0 = sprite->objY / 4.0f;
+            const float x1 = x0 + (imageW / 32.0f) * (1024.0f / scaleW);
+            const float y1 = y0 + (imageH / 32.0f) * (1024.0f / scaleH);
+
+            // Texture coordinates at the corners. drawTris takes them in half-texel units (twice the texel value, as
+            // the RDP triangle path produces for non-perspective triangles); verified by drawing unrotated sprites
+            // both ways, which matched only with this factor.
+            const float tcScale = 2.0f;
+            const bool flipS = (sprite->imageFlags & S2DEX_G_OBJ_FLAG_FLIPS) != 0;
+            const bool flipT = (sprite->imageFlags & S2DEX_G_OBJ_FLAG_FLIPT) != 0;
+            const float s0 = (flipS ? imageW / 32.0f : 0.0f) * tcScale;
+            const float s1 = (flipS ? 0.0f : imageW / 32.0f) * tcScale;
+            const float t0 = (flipT ? imageH / 32.0f : 0.0f) * tcScale;
+            const float t1 = (flipT ? 0.0f : imageH / 32.0f) * tcScale;
+
+            auto sx = [&](float x, float y) { return A * x + B * y + X; };
+            auto sy = [&](float x, float y) { return C * x + D * y + Y; };
+            const float pos[] = {
+                sx(x0, y0), sy(x0, y0), 0.0f, 1.0f,   sx(x1, y0), sy(x1, y0), 0.0f, 1.0f,   sx(x0, y1), sy(x0, y1), 0.0f, 1.0f,
+                sx(x1, y0), sy(x1, y0), 0.0f, 1.0f,   sx(x1, y1), sy(x1, y1), 0.0f, 1.0f,   sx(x0, y1), sy(x0, y1), 0.0f, 1.0f,
+            };
+            const float tc[] = { s0, t0, s1, t0, s0, t1,   s1, t0, s1, t1, s0, t1 };
+            const float col[24] = {};
+            rdp->drawTris(2, pos, tc, col, G_TX_RENDERTILE, 0);
+        }
+
+        // G_OBJ_SPRITE and the draw half of G_OBJ_LDTX_SPRITE: coordinates go through the matrix from G_OBJ_MOVEMEM.
+        // Unrotated matrices use the rectangle path (sub-pixel placement, seamless strips); rotation or skew
+        // (B, C != 0) uses two triangles.
+        void doObjSprite(State *state, const uObjSprite *sprite) {
+            const std::array<uint32_t, 6> &m = state->rsp->S2D.objMatrix;
+            const float A = float(int32_t(m[0])) / 65536.0f;
+            const float B = float(int32_t(m[1])) / 65536.0f;
+            const float C = float(int32_t(m[2])) / 65536.0f;
+            const float D = float(int32_t(m[3])) / 65536.0f;
+            const int32_t X = int16_t(m[4] >> 16);
+            const int32_t Y = int16_t(m[4] & 0xFFFF);
+            if ((B != 0.0f) || (C != 0.0f)) {
+                drawObjSpriteAffine(state, sprite, A, B, C, D, X / 4.0f, Y / 4.0f);
+                return;
+            }
+
+            drawObjSprite(state, sprite, X, Y, A, D);
+        }
+
+        // G_OBJ_MOVEMEM: gSPObjMatrix (whole uObjMtx: size 24, offset 0) or gSPObjSubMatrix (X, Y and BaseScale:
+        // size 8, offset 2 in 8-byte units = byte 16).
+        void objMoveMem(State *state, DisplayList **dl) {
+            const uint32_t size = (*dl)->p0(16, 8) + 1;
+            const uint32_t offset = (*dl)->p0(0, 16) * 8;
+            const uint32_t rdramAddress = state->rsp->fromSegmentedMasked((*dl)->w1) & RSP_DMA_MASK;
