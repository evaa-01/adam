+            std::array<uint32_t, 6> &m = state->rsp->S2D.objMatrix;
+            for (uint32_t i = 0; (i < size / 4) && ((offset / 4 + i) < m.size()); i++) {
+                m[offset / 4 + i] = words[i];
+            }
+        }
